<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>NetTrader.Lean.Algorithm</RootNamespace>
        <AssemblyName>Algorithm</AssemblyName>
        <OutputType>Library</OutputType>
        <DefaultItemExcludes>$(DefaultItemExcludes);backtests/*/code/**;live/*/code/**;optimizations/*/code/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="QuantConnect.Algorithm" Version="2.5.*"/>
        <PackageReference Include="QuantConnect.Algorithm.Framework" Version="2.5.*"/>
        <PackageReference Include="QuantConnect.Common" Version="2.5.*"/>
        <PackageReference Include="QuantConnect.Indicators" Version="2.5.*"/>
        <PackageReference Include="Microsoft.ML" Version="3.0.1"/>
        <PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1"/>
        <PackageReference Include="Skender.Stock.Indicators" Version="2.7.1"/>
    </ItemGroup>
    <ItemGroup>
        <!-- models/ now lives inside Algorithm/ itself (moved from the repo root — see docs/PLAN.md,
             "прогон #7": Lean CLI's Docker build mounts only the project directory as /LeanCLI, so a
             "..\models" glob pointing above it matched zero files and copied nothing, silently). Using
             Update (not Include) because the SDK's default implicit globs already pick these files up as
             None items; Include would duplicate them and fail the build with NETSDK1022. -->
        <None Update="models\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
