## .NET
bin/
obj/
*.user

## LEAN historical data — large, download via Lean CLI, do not commit
/data/*
!/data/.gitkeep

## ML model artifacts — ModelLong.zip/ModelShort.zip ARE committed (~800KB each, ported from
## nettrader/NetTrader.Worker/mlmodel/), small enough not to need Git LFS. Only ignore anything else
## that might land here (retraining scratch output, larger future models).
/models/*
!/models/.gitkeep
!/models/ModelLong.zip
!/models/ModelShort.zip
/Algorithm/models/

## LEAN CLI local config (contains local paths, not secrets by default, but keep out anyway)
.idea/
.vs/
.lean/

## Secrets / credentials — NEVER commit
*.env
.env.*
config.json
lean.json
**/credentials*.json
